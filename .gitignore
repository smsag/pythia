# ── Build output ──────────────────────────────────────────────────────────────
main.js
main.js.map
*.tsbuildinfo

# ── Dependencies ───────────────────────────────────────────────────────────────
node_modules/

# ── Test output ────────────────────────────────────────────────────────────────
coverage/

# ── Plugin runtime data ────────────────────────────────────────────────────────
# Contains conversation history — never commit; synced via Obsidian Sync / iCloud
data.json

# ── Environment / secrets ──────────────────────────────────────────────────────
.env
.env.*
*.local

# ── Logs ───────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS artefacts ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ─────────────────────────────────────────────────────────────────────
# Ignore all VS Code workspace config — editor preferences are personal
.vscode/
.idea/

# ── Claude Code ─────────────────────────────────────────────────────────────────
# Session data, worktree checkouts, and local settings
# Note: CLAUDE.md (agent instructions) IS tracked intentionally
.claude/

# ── Pruned embedding model (ADR-200) ────────────────────────────────────────
# Built by npm run model:prune, published to Hugging Face — never committed.
dist-models/

# ── Local docs ─────────────────────────────────────────────────────────────────
# Large design-reference assets used by agents — not distributed with the plugin.
docs/pythia-v3.html
docs/design-system.css
