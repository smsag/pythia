{
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2018",
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler",
    "strictNullChecks": true,
    "ignoreDeprecations": "5.0",
    "importHelpers": true,
    "lib": ["ES2018", "DOM", "DOM.Iterable"],
    "esModuleInterop": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
